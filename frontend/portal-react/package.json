{
  "name": "city-engineer-portal-preview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build --base=/portal-assets/",
    "publish:local": "npm run build && node publish-local.mjs",
    "build:system": "vite build --config system/vite.config.js",
    "test:system": "node --test system/tests/*.test.cjs system/tests/*.test.mjs",
    "publish:system": "npm run build:system && npm run test:system && node system/publish.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "parse5": "^8.0.1"
  }
}
